# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets never, the template always
.env*
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# Rust build artifacts
mini-services/*/target/

# SQLite database (environment-specific)
db/*.db
# WAL mode (src/lib/db.ts) writes these alongside the database, and they hold
# its contents — they were tracked before the journal mode changed.
db/*.db-journal
db/*.db-wal
db/*.db-shm
# `bun run export --backup` writes these next to the database.
db/backup-*.db

# Uploaded files. The database references them; they are not source.
/storage/

# graphify's working directories. The graph itself is committed, at docs/graph/ —
# these are the scratch space and the extraction cache it rebuilds from. Not
# anchored to the root: graphify writes a cache next to whatever it scans.
graphify-out/
