# Copy to .env (or run `bun run setup`, which does it for you).
#
# Relative to prisma/schema.prisma, so the same value works on every machine.
# Never use an absolute path here — it will not exist on anyone else's.
DATABASE_URL="file:../db/dev.db"

# ── What runs your agents ─────────────────────────────────────────────────────
#
# Without one of these, agents cannot act: mentioning one queues a turn that
# fails saying exactly this. Everything deterministic still works — objectives
# route, working groups assemble, gates evaluate as queries over the ledger,
# claims transition. The organisation just cannot think.
#
# Set an agent's `harnessName` to `anthropic` or `ollama` to pick which it uses.

# Hosted models. Get a key at console.anthropic.com.
# ANTHROPIC_API_KEY=

# Local models — no key, no account, no per-token cost. Install Ollama, run
# `ollama pull llama3.2`, and point this at it.
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# ── What the org may spend ────────────────────────────────────────────────────
#
# Cents per day, across every agent. A runaway loop with a hosted model spends
# real money, and a day's ceiling caps the damage at a day's worth. Past it,
# agent turns fail saying so rather than running. 0 means no ceiling.
# Default: 500 ($5.00).
# VUNO_DAILY_BUDGET_CENTS=500
