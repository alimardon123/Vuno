# Copy to .env (or run `bun run setup`, which does it for you).
#
# Relative to prisma/schema.prisma, so the same value works on every machine.
# Never use an absolute path here — it will not exist on anyone else's.
DATABASE_URL="file:../db/dev.db"

# Optional. Without one, agents run on the deterministic test harness and every
# feature except live model calls still works. See docs/adr/0006.
# ANTHROPIC_API_KEY=

# Optional. Local models need no key: point this at a running Ollama instance.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
