// AI Organization OS — Prisma schema
// Implements: tenant → org → department → team → member → agent
//              + append-only event spine
//              + epistemic ledger (claims with status + provenance)
//              + work graph (objectives, projects, decisions, experiments, artifacts)
//              + gates
// Per ADR-0003 (data model), ADR-0004 (event spine), ADR-0005 (ledger), ADR-0006 (agents)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Tenant ───────────────────────────────────────────────────────────────────
// One tenant can host multiple orgs. v1 ships one seeded tenant.
model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orgs        Organization[]
  members     Member[]
  events      Event[]
  claims      Claim[]
}

// ─── Member — one identity for humans and agents (ADR-0009) ──────────────────
// Parity is a schema property: any column that can hold an agent must be able to
// hold a human, and the reverse. There is no separate User or Agent table, so a
// feature physically cannot be built that works for one and not the other.
model Member {
  id            String   @id @default(cuid())
  tenantId      String
  orgId         String
  kind          String   // 'human' | 'agent'
  displayName   String
  handle        String   // @-mention handle
  avatarGlyph   String?
  status        String   @default("active")   // 'active' | 'suspended' | 'retired'
  // One presence vocabulary for every member. An agent's is written by the
  // orchestrator; a human sets theirs. Same field, same rendering.
  presenceState String   @default("offline")  // 'available' | 'busy' | 'away' | 'offline' | 'dnd'
  presenceNote  String?                       // the activity line, e.g. "running tests on #wal-format"
  teamId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  human         HumanProfile?
  agent         AgentProfile?
  assistants    AgentProfile[] @relation("AssistantOwner")

  authoredEvents  Event[]      @relation("EventActor")
  delegatedEvents Event[]      @relation("EventOnBehalfOf")
  claims          Claim[]      @relation("ClaimProvenance")
  memberships     Membership[]
  conversations   ChannelMember[]

  @@unique([orgId, handle])
  @@index([orgId, kind, status])
  @@index([teamId])
}

model HumanProfile {
  memberId   String   @id
  email      String   @unique
  timezone   String?
  isOrgOwner Boolean  @default(false)

  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model AgentProfile {
  memberId      String    @id
  role          String    // 'architect' | 'security' | 'perf' | 'hr' | ...
  modelName     String    @default("harness/deterministic")
  harnessName   String    @default("deterministic")
  tools         String    @default("[]")   // JSON array of tool ids
  permissions   String    @default("[]")   // JSON array of scoped capability ids
  // Set only for a personal assistant. An assistant is a member like any other;
  // this is who it works for, not who it renders as.
  ownerMemberId String?
  packageId     String?
  version       String?
  installedAt   DateTime  @default(now())
  retiredAt     DateTime?
  metadata      String?

  member        Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  owner         Member?   @relation("AssistantOwner", fields: [ownerMemberId], references: [id], onDelete: SetNull)

  @@index([role])
  @@index([ownerMemberId])
}

// ─── Organization ──────────────────────────────────────────────────────────────
model Organization {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  departments Department[]
  teams       Team[]
  channels    Channel[]
  members     Member[]
  events      Event[]
  claims      Claim[]
  objectives  Objective[]
  projects    Project[]
  decisions   Decision[]
  experiments Experiment[]
  gates       Gate[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

// ─── Department / Team ─────────────────────────────────────────────────────────
model Department {
  id          String   @id @default(cuid())
  tenantId    String
  orgId       String
  name        String   // Product, Engineering, Security, HR/Meta, etc.
  slug        String
  createdAt   DateTime @default(now())

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  teams       Team[]

  @@unique([orgId, slug])
  @@index([orgId])
}

model Team {
  id          String   @id @default(cuid())
  tenantId    String
  orgId       String
  departmentId String
  name        String
  slug        String
  leadAgentId String?  // ref to Agent, set via membership
  createdAt   DateTime @default(now())

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  department  Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  memberships Membership[]
  channels    Channel[]

  @@unique([orgId, slug])
  @@index([orgId, departmentId])
}

// A team contains members. No discriminator, no polymorphic string id —
// one foreign key, because a team member is a member (ADR-0009).
model Membership {
  id          String   @id @default(cuid())
  tenantId    String
  orgId       String
  teamId      String
  memberId    String
  role        String   // 'ORG_OWNER' | 'DEPARTMENT_HEAD' | 'TEAM_LEAD' | 'MEMBER' | 'HR_META'
  createdAt   DateTime @default(now())

  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([teamId, memberId])
  @@index([teamId, role])
  @@index([memberId])
}

// ─── Channels (chat surface) ───────────────────────────────────────────────────
model Channel {
  id          String   @id @default(cuid())
  tenantId    String
  orgId       String
  teamId      String?
  name        String   // e.g. "storage-engine"
  slug        String
  topic       String?
  // What kind of conversation this is, stated once. It used to be re-derived
  // from `isDm` plus a nullable teamId plus a slug prefix, in four places with
  // four answers (docs/IA-NAVIGATION.md).
  //   'channel'   — open, org-wide, listed under Channels
  //   'team_room'  — a team's default channel, listed under Channels
  //   'group'      — a named group chat, listed under Chats
  //   'dm'         — two participants, listed under Chats
  kind        String   @default("channel")
  createdAt   DateTime @default(now())

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team        Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  members     ChannelMember[]

  @@unique([orgId, slug])
  @@index([orgId, teamId])
  @@index([orgId, kind])
}

// Who is in a conversation. A DM names itself from these rows relative to the
// viewer, which is why a DM has no fixed name of its own. Humans and agents
// join through the same column (ADR-0009).
model ChannelMember {
  id          String   @id @default(cuid())
  tenantId    String
  orgId       String
  channelId   String
  memberId    String
  createdAt   DateTime @default(now())

  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([channelId, memberId])
  @@index([memberId])
}

// ─── Event Spine (append-only) ────────────────────────────────────────────────
// Per ADR-0004. NEVER update or delete rows. The chat surface is a projection.
model Event {
  // seq is the primary key so SQLite allocates it: AUTOINCREMENT is only
  // available on an INTEGER PRIMARY KEY, and having the database own the
  // sequence is what removes the read-MAX-then-insert race (ADR-0008).
  // Nothing holds a foreign key to Event.id, so moving the PK is safe.
  seq           Int      @id @default(autoincrement())
  id            String   @unique @default(cuid())
  type          String                     // discriminated union key
  payload       String                     // JSON-encoded, typed via TS
  tenantId      String
  orgId         String
  // 'member' for anything a person or an agent did; 'system' for events the
  // runtime emits on nobody's behalf. There is no per-kind actor column.
  actorType     String
  actorMemberId String?
  // Set only when the action carried another member's authority — an assistant
  // acting under a delegation. The assistant still renders as itself; this is
  // the authority, not the identity (ADR-0009 §1).
  onBehalfOfMemberId String?
  scopeType     String                     // 'channel' | 'decision' | 'project' | 'team' | 'org' | 'tenant'
  scopeId       String
  visibility    String   @default("org")   // 'tenant' | 'org' | 'team' | 'private'
  createdAt     DateTime @default(now())

  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor         Member?      @relation("EventActor", fields: [actorMemberId], references: [id], onDelete: SetNull)
  onBehalfOf    Member?      @relation("EventOnBehalfOf", fields: [onBehalfOfMemberId], references: [id], onDelete: SetNull)
  // NOTE: scopeId is intentionally NOT a foreign key. Events are polymorphic —
  // scopeId may reference a Channel, Decision, Project, Objective, Team, Org,
  // or Tenant. Queries filter by (scopeType, scopeId).

  @@index([tenantId, orgId, scopeType, scopeId, seq])
  @@index([type, createdAt])
  @@index([actorMemberId])
  @@index([onBehalfOfMemberId])
}

// ─── Epistemic Ledger ──────────────────────────────────────────────────────────
// Per ADR-0005. Every claim has status + provenance. Status transitions via events.
model Claim {
  id              String   @id @default(cuid())
  tenantId        String
  orgId           String
  statement       String
  status          String   @default("asserted")  // 'asserted' | 'believed' | 'tested' | 'falsified' | 'uncertain'
  scopeType       String   // 'project' | 'decision' | 'objective' | 'team' | 'org'
  scopeId         String
  provenanceEventId String // the Event that originated this claim
  provenanceActorType String
  // Whoever made the claim, human or agent. There is no agent-only column:
  // HR cannot score a person whose claims have no author (ADR-0009).
  provenanceMemberId String?
  supersedesId    String?  // optional: if this claim supersedes an earlier one
  evidenceIds     String   @default("[]")    // JSON array of evidence Event IDs
  contradictsIds  String   @default("[]")    // JSON array of claim IDs this contradicts
  statusReason    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  provenanceMember Member?     @relation("ClaimProvenance", fields: [provenanceMemberId], references: [id], onDelete: SetNull)

  // One claim per statement per scope. The debate route used to insert a fresh
  // row on every run, which is how the shipped database ended up holding nine
  // identical falsified claims. Status moves; claims are not re-created
  // (ADR-0005).
  @@unique([orgId, scopeType, scopeId, statement])
  @@index([tenantId, orgId, status])
  @@index([scopeType, scopeId])
  @@index([provenanceMemberId])
}

// ─── Work Graph ────────────────────────────────────────────────────────────────
model Objective {
  id              String   @id @default(cuid())
  tenantId        String
  orgId           String
  title           String
  successCriteria  String
  constraints      String?
  budget           String?
  autonomyLevel    String   @default("L2")  // L1-L4
  status          String   @default("filed") // 'filed' | 'active' | 'shipped' | 'killed'
  // Where this objective sits in the twelve-stage lifecycle. The orchestrator
  // advances it; nothing else writes it (ADR-0007).
  stage           String   @default("filed")
  stageEnteredAt  DateTime @default(now())
  owningDepartment String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projects        Project[]

  @@index([orgId, status])
}

model Project {
  id          String   @id @default(cuid())
  tenantId    String
  orgId       String
  objectiveId String?
  name        String
  slug        String
  description String?
  status      String   @default("active")
  createdAt   DateTime @default(now())

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  objective   Objective?    @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  decisions   Decision[]
  experiments Experiment[]
  gates       Gate[]

  @@unique([orgId, slug])
  @@index([orgId, objectiveId])
}

model Decision {
  id          String   @id @default(cuid())
  tenantId    String
  orgId       String
  projectId   String
  title       String
  state       String   @default("draft") // 'draft'|'open'|'contested'|'experiment_pending'|'resolved'|'escalated'
  proposerAgentId String?
  outcome     String?  // 'accepted' | 'rejected' | 'falsified' | 'superseded'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  gates       Gate[]

  @@index([orgId, projectId, state])
}

model Experiment {
  id          String   @id @default(cuid())
  tenantId    String
  orgId       String
  projectId   String
  kind        String   // 'benchmark' | 'load_test' | 'spike' | 'fuzz' | 'failure_injection'
  status      String   @default("requested") // 'requested' | 'running' | 'completed' | 'failed'
  result      String?  // JSON — the actual measurement results
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([orgId, projectId, status])
}

model Gate {
  id          String   @id @default(cuid())
  tenantId    String
  orgId       String
  projectId   String
  decisionId  String?
  name        String   // 'security' | 'qa' | 'performance' | 'release'
  // A structured predicate over the ledger, evaluated as a query — not prose.
  // See src/lib/gates. The human-readable form is derived from it, not stored.
  policy      String   @default("{}")
  // Which claims or risks satisfied the predicate at the last evaluation, so a
  // blocked gate can name what blocked it.
  evidence    String   @default("[]")
  state       String   @default("pending") // 'pending' | 'passed' | 'blocked'
  reason      String?
  evaluatedAt DateTime?
  createdAt   DateTime @default(now())

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  decision    Decision?     @relation(fields: [decisionId], references: [id], onDelete: SetNull)

  @@index([orgId, projectId, state])
  @@index([decisionId])
}

// ─── Personal Assistant Memory (Tier 2) ──────────────────────────────────────
// Per the vision doc §6: "Personal assistant: Owner's files, history,
// preferences. Visible to owner only."
// Bob (Kai's personal assistant) accumulates Kai's preferences over time.
// Key-value store per agent+owner. Queryable by the agent for context.
model PersonalMemory {
  id            String   @id @default(cuid())
  tenantId      String
  orgId         String
  agentId       String   // the assistant's member id
  ownerHumanId  String   // the owner's member id
  key           String   // e.g. "preferred_language", "coding_style", "meeting_preferences"
  value         String   // the stored value (JSON or plain text)
  category      String   @default("preference") // "preference" | "fact" | "history" | "context"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([agentId, key])
  @@index([agentId, ownerHumanId])
  @@index([orgId, agentId])
}

// ─── Team Memory (Tier 3) ────────────────────────────────────────────────────
// Per the vision doc §6: "Team: Team conventions, in-flight work, local
// decisions. Visible to team members."
// Implemented as team-scoped AgentThought events with visibility='team' on
// the event spine — no new table needed. The /api/thoughts endpoint filters
// by visibility. See ADR-0005 for the event-based memory architecture.

// ─── Agent Private Memory (Tier 1) ──────────────────────────────────────────
// Per the vision doc §6: "Agent private: Working notes, in-progress
// reasoning. Visible to that agent only."
// Each agent's private scratchpad — their working notes, hypotheses in
// progress, TODO lists, context from past interactions. Not visible to
// other agents or humans. This is where agents "think" before producing
// org-visible AgentThought events.
model AgentMemory {
  id        String   @id @default(cuid())
  tenantId  String
  orgId     String
  agentId   String
  key       String   // e.g. "working_hypothesis", "todo", "context_from_last_debate"
  value     String   // JSON or plain text
  category  String   @default("working") // "working" | "todo" | "context" | "hypothesis"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentId, key])
  @@index([orgId, agentId])
}



// ─── Orchestrator (ADR-0007) ─────────────────────────────────────────────────

/// A unit of work the orchestrator owns. Leases are what make it crash-safe: a
/// worker that dies mid-run lets its lease expire and the item is picked up
/// again rather than lost.
model WorkItem {
  id            String    @id @default(cuid())
  tenantId      String
  orgId         String
  kind          String    // 'route_objective' | 'define_problem' | 'propose' | ...
  subjectType   String    // 'objective' | 'decision' | 'claim' | 'channel'
  subjectId     String
  objectiveId   String?   // set when the item belongs to an objective's lifecycle
  /// Which member should do this. Null means "any member matching the kind's
  /// role" — resolved at dispatch. A human and an agent are equally assignable.
  assigneeId    String?

  state         String    @default("pending") // 'pending'|'leased'|'done'|'failed'|'cancelled'
  priority      Int       @default(0)         // higher runs first
  runAfter      DateTime  @default(now())     // not eligible before this

  leasedBy      String?                       // worker id holding the lease
  leaseExpiresAt DateTime?
  attempts      Int       @default(0)
  maxAttempts   Int       @default(3)
  lastError     String?

  /// Stops the same work being enqueued twice. Unique among items that have not
  /// finished, so a completed item does not block re-running the same step later.
  dedupeKey     String?

  input         String    @default("{}")      // JSON
  result        String?                       // JSON, set on completion

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  startedAt     DateTime?
  finishedAt    DateTime?

  sessions      WorkSession[]

  @@index([orgId, state, runAfter, priority])
  @@index([objectiveId, state])
  @@index([leaseExpiresAt])
  @@unique([orgId, dedupeKey])
}

/// One attempt at a work item by one member. Universal on purpose: a human
/// working an item has a start, an end and a cost in time; an agent has the same
/// plus model and token detail. HR reads this for both (ADR-0009 Part 3).
model WorkSession {
  id            String    @id @default(cuid())
  tenantId      String
  orgId         String
  workItemId    String
  memberId      String

  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  durationMs    Int?
  outcome       String    @default("running") // 'running'|'succeeded'|'failed'|'abandoned'
  error         String?

  /// Cost in whole cents. Agent runs convert tokens; human work can carry time
  /// at a rate, or nothing. Either way "cost per resolved decision" is a query.
  costCents     Int       @default(0)

  // Agent execution detail. Null for a human's session.
  modelName     String?
  harnessName   String?
  tokensIn      Int?
  tokensOut     Int?

  workItem      WorkItem  @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@index([orgId, memberId, startedAt])
  @@index([workItemId])
}
